{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "jsx": "react",
    "downlevelIteration": true,
    "esModuleInterop": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "lib": ["es2022", "dom", "webworker"],
    "skipLibCheck": true,
    "incremental": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "*": ["./packages/*/src"]
    }
  },
  "exclude": [
    "**/dist/*",
    "node_modules",
    "**/__mocks__/*",
    "**/*.spec.js",
    "**/*.spec.jsx",
    "coverage",
    "cli"
  ],
  "references": [
    { "path": "./packages/fmbids-openneuro-app" },
    { "path": "./packages/fmbids-openneuro-indexer" },
    { "path": "./packages/fmbids-openneuro-search" },
    { "path": "./packages/fmbids-openneuro-server" }
  ]
}
